# Copy to .env and fill in. Never commit .env.

# --- GitHub App ---
GITHUB_APP_ID=123456
# Set exactly one: inline PEM (newlines as \n inside double quotes) or a path to the PEM file.
# In compose the path must be readable inside the container (mount it), so inline is simplest there.
# GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# --- Infra (compose overrides DATABASE_URL/REDIS_URL for the containers) ---
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://pr_review:change-me-db-password@localhost:5432/pr_review
REDIS_URL=redis://localhost:6379
# Set DOCKER_GID to `stat -c %g /var/run/docker.sock` (Linux) / the socket's group (Docker Desktop: 0).
# Default 65534 grants no access: the worker shows unhealthy and cannot start sandboxes.
DOCKER_GID=65534

# --- LLM (local Ollama on the host by default) ---
LLM_REVIEW_MODEL=ollama/qwen2.5-coder:7b
LLM_TRIAGE_MODEL=ollama/qwen2.5-coder:1.5b
# JSON list of fallback models, e.g. ["ollama/qwen2.5-coder:0.5b"]
LLM_FALLBACK_MODELS=[]
# Only for hosted providers; leave unset for Ollama
# LLM_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434
LLM_JOB_BUDGET_USD=1.0
LLM_DAILY_BUDGET_USD=20.0

# --- Admin API (unset = admin API disabled) ---
ADMIN_TOKEN=change-me-admin-token

# --- Behaviour ---
RETENTION_DAYS=30
RETENTION_HOUR_UTC=3
REQUEST_CHANGES_ON_CRITICAL=false

# --- Worker ---
WORKER_MAX_JOBS=4
WORKER_LEASE_SECONDS=300
JOB_DEADLINE_SECONDS=3600
STAGE_TIMEOUT_SECONDS=300
ANALYSE_TIMEOUT_SECONDS=1200
SWEEP_INTERVAL_SECONDS=30
# Parent dir of ephemeral checkouts (unset = system temp)
# WORKSPACE_ROOT=/tmp/pr-review
WORKSPACE_MAX_BYTES=1073741824

# --- Sandbox / tests ---
SANDBOX_MAX_REPO_BYTES=1073741824
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_CPUS=1.0
TEST_TIMEOUT_SECONDS=300
# Optional pip index override (caching mirror); its host:port is the only extra egress destination
# SANDBOX_PIP_INDEX_URL=
